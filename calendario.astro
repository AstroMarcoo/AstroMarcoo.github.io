---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Calendario astronomico — AstroMarco">
  <section class="section">
    <span class="kicker">Calendario astronomico</span>
    <h1>Il cielo ha sempre qualcosa da raccontare.</h1>
    <p class="sub">Questa pagina sarà il calendario aggiornabile degli eventi astronomici. Le date di esempio qui sotto sono segnaposto.</p>
    <div style="margin-top:38px">
      <div class="event"><div class="date">01<small>Ott</small></div><div><strong>Evento da inserire</strong><p class="sub">Data, orario, visibilità e spiegazione semplice.</p></div></div>
      <div class="event"><div class="date">12<small>Ott</small></div><div><strong>Evento da inserire</strong><p class="sub">Data, orario, visibilità e spiegazione semplice.</p></div></div>
      <div class="event"><div class="date">21<small>Ott</small></div><div><strong>Evento da inserire</strong><p class="sub">Data, orario, visibilità e spiegazione semplice.</p></div></div>
    </div>
  </section>
</Layout>