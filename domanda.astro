---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Fammi una domanda — AstroMarco">
  <section class="section">
    <span class="kicker">Community</span>
    <h1>Fammi una domanda.</h1>
    <p class="sub">Hai una curiosità sull'universo? Scrivila qui. In una seconda fase collegheremo questo modulo al servizio che preferisci.</p>
    <form style="max-width:700px;margin-top:35px;display:grid;gap:14px">
      <input aria-label="Nome" placeholder="Il tuo nome" style="padding:16px;border:1px solid #ddd6e5;border-radius:14px;font:inherit">
      <input aria-label="Email" placeholder="La tua email" type="email" style="padding:16px;border:1px solid #ddd6e5;border-radius:14px;font:inherit">
      <textarea aria-label="Domanda" placeholder="La tua domanda..." rows="7" style="padding:16px;border:1px solid #ddd6e5;border-radius:14px;font:inherit"></textarea>
      <button type="button" class="button primary" style="cursor:pointer">Invia domanda</button>
    </form>
  </section>
</Layout>