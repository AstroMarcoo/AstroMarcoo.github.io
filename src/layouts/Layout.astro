---
const { title = "AstroMarco — L'universo, raccontato semplice" } = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AstroMarco — astronomia spiegata in modo semplice e coinvolgente." />
    <title>{title}</title>
    <style>
      :root {
        --purple:#471485;
        --purple-2:#7b35c5;
        --ink:#111015;
        --muted:#66616d;
        --line:#e9e5ee;
        --soft:#f7f4fa;
        --white:#fff;
      }
      *{box-sizing:border-box}
      html{scroll-behavior:smooth}
      body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff}
      a{color:inherit;text-decoration:none}
      .nav{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.86);backdrop-filter:blur(16px);border-bottom:1px solid rgba(71,20,133,.08)}
      .nav-inner{max-width:1160px;margin:auto;padding:18px 24px;display:flex;align-items:center;justify-content:space-between;gap:24px}
      .brand{font-weight:900;letter-spacing:-.04em;font-size:1.25rem}
      .brand span{color:var(--purple)}
      .links{display:flex;gap:24px;align-items:center;font-size:.92rem;color:#4d4853}
      .links a:hover{color:var(--purple)}
      .cta{padding:11px 17px;border-radius:999px;background:var(--purple);color:#fff!important;font-weight:750}
      main{overflow:hidden}
      .hero{min-height:76vh;display:grid;place-items:center;position:relative;padding:90px 24px;background:
        radial-gradient(circle at 78% 28%,rgba(123,53,197,.25),transparent 27%),
        radial-gradient(circle at 12% 70%,rgba(71,20,133,.11),transparent 25%),
        linear-gradient(135deg,#fff 0%,#fbf9fd 55%,#eee5f7 100%)}
      .hero:after{content:"";position:absolute;width:520px;height:520px;border-radius:50%;right:-180px;bottom:-250px;background:linear-gradient(135deg,rgba(71,20,133,.22),rgba(255,255,255,.05));filter:blur(2px)}
      .hero-inner{max-width:1160px;width:100%;position:relative;z-index:1}
      .eyebrow{display:inline-flex;padding:8px 13px;border:1px solid rgba(71,20,133,.16);border-radius:999px;color:var(--purple);font-size:.82rem;font-weight:800;background:rgba(255,255,255,.7)}
      h1{font-size:clamp(3.4rem,8vw,7.5rem);line-height:.9;letter-spacing:-.075em;max-width:850px;margin:24px 0}
      h1 .gradient{background:linear-gradient(100deg,var(--purple),#bda4d8 70%,#fff);-webkit-background-clip:text;background-clip:text;color:transparent}
      .lead{font-size:clamp(1.1rem,2vw,1.35rem);line-height:1.65;color:#55505b;max-width:650px}
      .actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}
      .button{padding:14px 20px;border-radius:14px;font-weight:800;border:1px solid var(--line);background:#fff}
      .button.primary{background:var(--purple);border-color:var(--purple);color:#fff}
      .section{max-width:1160px;margin:auto;padding:92px 24px}
      .section.soft{max-width:none;background:var(--soft)}
      .section-inner{max-width:1160px;margin:auto}
      .kicker{font-size:.78rem;text-transform:uppercase;letter-spacing:.14em;color:var(--purple);font-weight:900}
      h2{font-size:clamp(2.1rem,4vw,3.7rem);letter-spacing:-.055em;line-height:1;margin:10px 0 16px}
      .sub{color:var(--muted);max-width:620px;line-height:1.65}
      .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:38px}
      .card{border:1px solid var(--line);border-radius:24px;background:#fff;padding:25px;min-height:240px;display:flex;flex-direction:column;justify-content:space-between;transition:.2s}
      .card:hover{transform:translateY(-4px);box-shadow:0 18px 45px rgba(42,20,60,.08)}
      .tag{font-size:.75rem;font-weight:800;color:var(--purple);text-transform:uppercase}
      .card h3{font-size:1.45rem;letter-spacing:-.035em;margin:12px 0}
      .card p{color:var(--muted);line-height:1.55}
      .arrow{color:var(--purple);font-weight:900}
      .calendar{display:grid;grid-template-columns:1.2fr .8fr;gap:28px;margin-top:38px}
      .event{padding:24px;border-radius:22px;background:#fff;border:1px solid var(--line);margin-bottom:12px;display:flex;gap:20px;align-items:center}
      .date{width:64px;height:64px;border-radius:18px;background:var(--purple);color:#fff;display:grid;place-items:center;font-weight:900;text-align:center;line-height:1}
      .date small{display:block;font-size:.65rem;text-transform:uppercase}
      .about{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:center}
      .portrait{min-height:420px;border-radius:34px;background:linear-gradient(145deg,#471485,#fff);position:relative;overflow:hidden}
      .portrait:after{content:"ASTROMARCO";position:absolute;bottom:28px;left:28px;color:#fff;font-weight:950;font-size:2rem;letter-spacing:-.06em}
      .question{border-radius:32px;padding:52px;background:linear-gradient(135deg,#471485,#7b35c5 55%,#fff);color:#fff;display:flex;align-items:end;justify-content:space-between;gap:30px}
      .question h2{max-width:650px}
      footer{background:#10091a;color:#fff;padding:45px 24px}
      .footer-inner{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:30px;align-items:center}
      .footer-muted{color:#bdb3c7}
      @media(max-width:800px){
        .links a:not(.cta){display:none}
        .grid,.calendar,.about{grid-template-columns:1fr}
        .hero{min-height:70vh;padding-top:70px}
        .about{gap:30px}
        .portrait{min-height:300px}
        .question{display:block}
        .footer-inner{display:block}
      }
    </style>
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">Astro<span>Marco</span></a>
        <nav class="links">
          <a href="/articoli">Articoli</a>
          <a href="/calendario">Calendario</a>
          <a href="/chi-sono">Chi sono</a>
          <a class="cta" href="https://beacons.ai/astromarco" target="_blank" rel="noreferrer">Seguimi</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="footer-inner">
        <div><strong>AstroMarco</strong><div class="footer-muted">L'universo, raccontato in modo semplice.</div></div>
        <a href="https://beacons.ai/astromarco" target="_blank" rel="noreferrer" class="footer-muted">Tutti i miei link →</a>
      </div>
    </footer>
  </body>
</html>